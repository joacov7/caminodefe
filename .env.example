# Camino de Fe — variables de entorno de ejemplo.
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas `.env.local` ni secretos reales al repositorio.

# --- Base de datos (Neon / Postgres) ---
# Cadena de conexión de Neon (incluye ?sslmode=require).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/caminodefe?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generá un secreto con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""
# URL pública de la app (en local: http://localhost:3000)
AUTH_URL="http://localhost:3000"
# OAuth con Google (necesario para "Continuar con Google")
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Enlace mágico por correo (Resend) — necesario para "Enviarme un enlace"
# API key en https://resend.com/api-keys ; el remitente debe estar verificado.
AUTH_RESEND_KEY=""
EMAIL_FROM="Camino de Fe <no-reply@tu-dominio.com>"

# --- Proveedor de IA (OpenAI) ---
# API key de OpenAI. Requerida para el asistente (Paso 3).
OPENAI_API_KEY=""
# Modelos por defecto (configurables).
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
