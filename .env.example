# Camino de Fe — variables de entorno de ejemplo.
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA subas `.env.local` ni secretos reales al repositorio.

# --- Base de datos (Neon / Postgres) ---
# Cadena de conexión de Neon (incluye ?sslmode=require).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/caminodefe?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generá un secreto con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET=""
# URL pública de la app (en local: http://localhost:3000)
AUTH_URL="http://localhost:3000"
# OAuth con Google (necesario para "Continuar con Google")
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Enlace mágico por correo (Resend) — necesario para "Enviarme un enlace"
# API key en https://resend.com/api-keys ; el remitente debe estar verificado.
AUTH_RESEND_KEY=""
EMAIL_FROM="Camino de Fe <no-reply@tu-dominio.com>"

# --- Proveedor de IA (OpenAI) ---
# API key de OpenAI. Requerida para el asistente (Paso 3).
OPENAI_API_KEY=""
# Modelos por defecto (configurables).
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- URL pública (metadatos, sitemap, enlaces compartibles, webhooks) ---
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# --- Pagos (OPCIONAL) — Mercado Pago Checkout Pro ---
# Sin token: los aportes se registran como "pendiente" (sin cobro real).
# Probar primero con credenciales de PRUEBA (sandbox) antes de producción.
MERCADOPAGO_ACCESS_TOKEN=""
# Secreto para validar la firma de los webhooks (panel de Mercado Pago → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Solo desarrollo/CI (NO en producción) ---
# Usar node-postgres contra un Postgres local en vez de Neon HTTP.
# DATABASE_DRIVER="pg"
# TEST_DATABASE_URL="postgresql://cdf_owner:cdf@localhost:5432/cdf"

# --- Mantenimiento diario (Vercel Cron → /api/cron/mantenimiento) ---
# Purga conversaciones borradas hace > 30 días, sesiones y tokens vencidos.
# Generar con: openssl rand -hex 32
CRON_SECRET=""
